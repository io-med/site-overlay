{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.10.1",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://github.com/io-med/site-overlay",
  "default_locale": "en",
  "minimum_chrome_version": "126",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["declarativeNetRequest", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ]
}
